{
  "description": "ACME Corp Application Security Requirements",
  "url": "https://appsec.int.example.com",
  "output": "../data/appsec-requirements-fallback.yaml",
  "openspec": {
    "output": "../data/application-requirements.openspec.md",
    "title": "ACME Application Specification",
    "purpose": "Defines observable application behavior harvested from ACME's functional requirement sources."
  },
  "blueprint_split": {
    "_note": "Optional. Writes one catalog-shaped YAML per blueprint in addition to the catalog above; the catalog itself keeps all blueprints.",
    "enabled": false,
    "output_dir": "../data/blueprints"
  },
  "specdd": {
    "output": "../data/application-requirements.sdd",
    "name": "ACME Application Behavior",
    "purpose": "Describe observable application behavior harvested from ACME's functional requirement sources."
  },

  "request": {
    "timeout_seconds": 15,
    "auth_header_env": "HARVEST_AUTH_TOKEN",
    "verify_ssl": true,
    "use_proxy": true,
    "extra_headers": {}
  },

  "defaults": {
    "max_pages": 100,
    "requirements_mode": "structured",
    "blueprints_mode": "full",
    "section_max_chars": 5000
  },

  "sources": [
    {
      "id": "secure-coding-guidelines",
      "type": "requirement",
      "mode": "structured",
      "title": "Secure Coding Guidelines",
      "outputs": ["catalog"],
      "crawl_url": "https://appsec.int.example.com/scg",
      "reference_url": "https://appsec.int.example.com/scg"
    },
    {
      "id": "secure-sdlc",
      "type": "requirement",
      "mode": "structured",
      "title": "Secure Software Development Lifecycle",
      "outputs": ["catalog"],
      "crawl_url": "https://appsec.int.example.com/ssdlc",
      "reference_url": "https://appsec.int.example.com/ssdlc"
    },
    {
      "id": "application-behavior",
      "type": "requirement",
      "mode": "structured",
      "title": "Application Functional Requirements",
      "outputs": ["openspec", "specdd"],
      "crawl_url": "https://product.int.example.com/requirements",
      "reference_url": "https://product.int.example.com/requirements"
    },
    {
      "id": "appsec-blueprints",
      "type": "blueprint",
      "mode": "full",
      "title": "Application Security Blueprints",
      "outputs": ["catalog"],
      "_note": "crawl_url is indexed itself, then direct same-origin child links under this path are indexed up to max_pages.",
      "crawl_url": "https://appsec.int.example.com/blueprints",
      "section_max_chars": 50000
    }
  ]
}

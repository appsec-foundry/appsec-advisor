+HELD = "docs/internal/decisions.md"
+
+
+def edit(old: str, new: str, **extra) -> dict:
+    return {
+        "hook_event_name": "PreToolUse",
+        "tool_name": "Edit",
+        "tool_input": {"file_path": HELD, "old_string": old, "new_string": new, **extra},
+    }
+
+
+def test_a_new_decision_row_is_added_without_approval():
+    row = "| OR-1 | An existing decision | `a_guard` | `a_source.py` |"
+    assert requirements_hook.decide(edit(row, row + "\n| OR-2 | A new decision | `b_guard` | `b.py` |")) is None
+
+
+def test_a_new_section_is_added_without_approval():
+    heading = "## Orchestration"
+    assert requirements_hook.decide(edit(heading, "## A new area\n\n| ID |\n\n" + heading)) is None
+
+
+@pytest.mark.parametrize(
+    ("old", "new"),
+    [
+        ("| OR-1 | Narrow | `g` | `s.py` |", "| OR-1 | Wider | `g` | `s.py` |"),
+        ("| OR-1 | A decision | `g` | `s.py` |", ""),
+        ("ask the operator first", "ask the operator when convenient"),
+    ],
+    ids=["widened", "removed", "rule-relaxed"],
+)
+def test_changing_what_the_register_already_says_asks(old, new):
+    assert output(requirements_hook.decide(edit(old, new)))["permissionDecision"] == "ask"
+
+
+def test_replacing_every_occurrence_asks():
+    row = "| OR-1 | A decision | `g` | `s.py` |"
+    call = edit(row, row + "\n| OR-2 | Another | `g2` | `s2.py` |", replace_all=True)
+    assert output(requirements_hook.decide(call))["permissionDecision"] == "ask"
+
+
+def test_a_whole_file_write_asks_even_when_it_only_adds():
+    call = {
+        "hook_event_name": "PreToolUse",
+        "tool_name": "Write",
+        "tool_input": {"file_path": HELD, "content": "everything, plus one row"},
+    }
+    assert output(requirements_hook.decide(call))["permissionDecision"] == "ask"
+
+
+def test_a_multi_edit_asks_unless_every_edit_only_adds():
+    adds = {"old_string": "| OR-1 | A |", "new_string": "| OR-1 | A |\n| OR-2 | B |"}
+    changes = {"old_string": "| OR-3 | C |", "new_string": "| OR-3 | Wider |"}
+    call = {
+        "hook_event_name": "PreToolUse",
+        "tool_name": "MultiEdit",
+        "tool_input": {"file_path": HELD, "edits": [adds]},
+    }
+    assert requirements_hook.decide(call) is None
+    call["tool_input"]["edits"] = [adds, changes]
+    assert output(requirements_hook.decide(call))["permissionDecision"] == "ask"
+
+
+def test_a_shell_write_to_the_register_asks():
+    call = {
+        "hook_event_name": "PreToolUse",
+        "tool_name": "Bash",
+        "tool_input": {"command": f"echo '| OR-2 | new |' >> {HELD}"},
+    }
+    assert output(requirements_hook.decide(call))["permissionDecision"] == "ask"
+
+
 def test_decision_register_requires_approval_through_an_absolute_path():

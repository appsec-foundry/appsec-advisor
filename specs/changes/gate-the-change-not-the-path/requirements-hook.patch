+def _is_insertion(edit: object) -> bool:
+    """Whether one edit only adds text around what it replaces."""
+    if not isinstance(edit, dict) or edit.get("replace_all"):
+        return False
+    old, new = edit.get("old_string"), edit.get("new_string")
+    if not isinstance(old, str) or not isinstance(new, str) or not old:
+        return False
+    return new != old and old in new
+
+
+def adds_without_changing(tool: str, tool_input: dict) -> bool:
+    """Whether the call can only add entries to the held register.
+
+    The register holds the operator's approval for changing a decision, not for
+    recording one, and a `PreToolUse` payload cannot see the file the call would
+    produce. An `Edit` payload does carry the text it replaces and the text it
+    writes, which answers the narrower question this rule needs: everything the
+    call replaces survives it byte-identical, so no row and no rule can be
+    loosened by it. `Write` replaces the whole file, `replace_all` multiplies an
+    edit across occurrences the payload does not name, and a shell command is
+    opaque here; each keeps asking.
+    """
+    if tool == "Edit":
+        return _is_insertion(tool_input)
+    if tool == "MultiEdit":
+        edits = tool_input.get("edits")
+        return isinstance(edits, list) and bool(edits) and all(_is_insertion(edit) for edit in edits)
+    return False
+
+

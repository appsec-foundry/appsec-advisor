+    (cache_dir / "baseline.json").write_text("{not json", encoding="utf-8")
+    (tmp_path / ".scan-start-epoch").write_text("1000", encoding="utf-8")
+    monkeypatch.setattr(prb, "_net_wall_seconds", lambda *a, **k: None)

{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/spec_guard.py",
              "--protected-dir",
              "${CLAUDE_PROJECT_DIR}/specs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/requirements_hook.py"
            ]
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Edit(/specs/**)"
    ]
  },
  "sandbox": {
    "enabled": true
  }
}

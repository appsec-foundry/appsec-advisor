{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Editorial QA comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "gate_exit",
    "actions",
    "qa_status_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "status": {
      "enum": [
        "baseline",
        "accepted",
        "regression"
      ]
    },
    "gate_exit": {
      "type": "integer"
    },
    "actions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "qa_status_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

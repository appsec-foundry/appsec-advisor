{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://appsec-advisor/schemas/editorial-plan.schema.json",
  "title": "Editorial Plan",
  "description": "Completed editorial packet, bound to the run and batch that supplied its block ids. Legacy single plans remain readable. A missing packet is incomplete, never no_change.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "generated",
        "status",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1,
          "description": "Legacy single-plan format."
        },
        "generated": {
          "type": "string",
          "description": "ISO 8601 UTC timestamp written by the editorial pass."
        },
        "status": {
          "type": "string",
          "enum": [
            "edits",
            "no_change"
          ],
          "description": "`no_change` means the pass read the projection and found nothing worth rewriting. It requires an empty `actions` array."
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "batch_id",
        "status",
        "actions"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "batch_id": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "status": {
          "enum": [
            "edits",
            "no_change"
          ]
        },
        "actions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "replace"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^b[0-9]{3,6}$"
              },
              "replace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "rationale": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "file",
        "find",
        "replace"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "enum": [
            "threat-model.yaml",
            ".fragments/security-architecture.md",
            ".fragments/ms-verdict.json",
            ".fragments/ms-anti-patterns.json"
          ],
          "description": "Path relative to $OUTPUT_DIR. The applier hard-rejects anything else; the six force-regenerated fragments are excluded because the next compose overwrites them."
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[[0-9]+\\]|\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "description": "Structured field address; Markdown actions use null or omit it. The applier admits only editable fields."
        },
        "find": {
          "type": "string",
          "minLength": 1,
          "description": "For a field address, the field's current value verbatim \u2014 it is the optimistic lock, and a mismatch rejects the action. For the Markdown fragment, a block that occurs exactly once."
        },
        "replace": {
          "type": "string",
          "minLength": 1,
          "description": "The rewritten prose. Identifiers, links, code spans, paths, `file:line` locators and numbers must survive unchanged; check_editorial_diff.py reverts the run when they do not."
        },
        "rationale": {
          "type": "string",
          "description": "Optional short explanation of the proposed wording change."
        }
      }
    }
  }
}

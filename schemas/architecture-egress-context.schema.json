{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/architecture-egress-context.schema.json",
  "title": "Outbound destinations the architecture data flows must account for",
  "description": "Deterministic call sites of HTTP, WebSocket and RPC clients, grouped by destination. A fixed-host destination is an external service the code calls; a user-controlled destination is chosen by the request. The architecture analyst receives them before it writes data flows.",
  "type": "object",
  "required": ["schema_version", "limits", "destinations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "limits": {
      "type": "object",
      "required": ["max_destinations", "max_evidence", "omitted_destinations"],
      "additionalProperties": false,
      "properties": {
        "max_destinations": {"const": 24},
        "max_evidence": {"const": 5},
        "omitted_destinations": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "destinations": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["kind", "host", "transport", "clients", "evidence", "omitted_evidence"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["fixed-host", "user-controlled"]},
          "host": {"type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"},
          "transport": {"enum": ["http", "websocket", "rpc"]},
          "clients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "uniqueItems": true,
            "items": {
              "enum": ["rpc-provider", "web3", "websocket", "fetch", "axios", "got", "node-http", "requests", "httpx", "urlopen", "go-http"]
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["file", "line"],
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/]|[A-Za-z][A-Za-z0-9+.-]*://)|(?:^|/)\\.\\.(?:/|$)|\\\\"}
                },
                "line": {"type": "integer", "minimum": 1}
              }
            }
          },
          "omitted_evidence": {"type": "integer", "minimum": 0, "maximum": 100000}
        },
        "if": {"properties": {"kind": {"const": "fixed-host"}}},
        "then": {"properties": {"host": {"type": "string"}}},
        "else": {"properties": {"host": {"type": "null"}}}
      }
    }
  }
}

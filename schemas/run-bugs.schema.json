{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/appsec-advisor/run-bugs.schema.json",
  "title": "run-bugs sidecar",
  "description": "Post-run plugin-bug diagnosis written by appsec-run-diagnostician and rendered by scripts/render_run_diagnosis.py. Developer-mode only (APPSEC_PLUGIN_DEV=1); never part of a user deliverable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated", "issues_total", "issues_examined", "summary", "diagnoses"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp (Z suffix)."
    },
    "issues_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Issue count in .run-issues.json the diagnosis was built from."
    },
    "issues_examined": {
      "type": "integer",
      "minimum": 0,
      "description": "How many of those issues were actually diagnosed. Lower than issues_total when the examination cap applied; the renderer surfaces the gap so a cap is never silent."
    },
    "examination_cap": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Cap the diagnostician was told to honour, or null when no cap applied."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_bug", "environment", "expected", "inconclusive"],
      "properties": {
        "plugin_bug": {"type": "integer", "minimum": 0},
        "environment": {"type": "integer", "minimum": 0},
        "expected": {"type": "integer", "minimum": 0},
        "inconclusive": {"type": "integer", "minimum": 0}
      }
    },
    "diagnoses": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnosis"}
    }
  },
  "$defs": {
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "issue_title", "verdict", "confidence", "rationale", "evidence"],
      "properties": {
        "issue_id": {
          "type": "string",
          "pattern": "^ISSUE-[0-9]{3}$"
        },
        "issue_title": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": ["plugin_bug", "environment", "expected", "inconclusive"],
          "description": "plugin_bug = a defect in this repository's own code/prompts/contracts. environment = model, API, sandbox, or target-repository cause outside the plugin. expected = the pipeline behaved as designed and the issue is informational. inconclusive = evidence did not settle it."
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this verdict, in one or two sentences."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Concrete pointers the verdict rests on: `<file>:<line>` in the plugin, or `<log>:<line>` in the run logs."
        },
        "root_cause": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["location", "description", "causal_path"],
              "properties": {
                "location": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Plugin-relative `<path>` or `<path>:<line>` of the producing code, prompt, or contract."
                },
                "component": {
                  "type": "string",
                  "description": "Optional coarse owner, e.g. `stride dispatch`, `compose`, `qa`."
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What is wrong at that location."
                },
                "causal_path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "How that defect produces the observed symptom, step by step."
                }
              }
            }
          ]
        },
        "suggested_fix": {
          "type": ["string", "null"],
          "description": "Free-text repair direction. Advisory only — nothing in the pipeline applies it."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"verdict": {"const": "plugin_bug"}},
            "required": ["verdict"]
          },
          "then": {
            "required": ["root_cause"],
            "properties": {"root_cause": {"type": "object"}}
          }
        }
      ]
    }
  }
}

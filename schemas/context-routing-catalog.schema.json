{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/context-routing-catalog.schema.json",
  "title": "Human-readable Stage-1 context catalog",
  "type": "object",
  "required": ["schema_version", "catalog_id", "categories", "agents", "contexts", "assignments"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"$ref": "#/$defs/id"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/category"}
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/agent"}
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/context"}
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/assignment"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "plain_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "category": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/plain_text"},
        "description": {"$ref": "#/$defs/plain_text"}
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": ["id", "name", "purpose", "scope", "stage"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/plain_text"},
        "purpose": {"$ref": "#/$defs/plain_text"},
        "scope": {"enum": ["whole_run", "one_component", "one_candidate"]},
        "stage": {"$ref": "#/$defs/plain_text"}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["id", "name", "category", "description", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/plain_text"},
        "category": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/plain_text"},
        "scope": {"enum": ["whole_run", "one_component", "one_candidate"]}
      },
      "additionalProperties": false
    },
    "applies_to": {
      "enum": ["whole_run", "current_component", "current_candidate"]
    },
    "assignment": {
      "type": "object",
      "required": ["id", "context", "agents", "delivery", "importance", "applies_to", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "context": {"$ref": "#/$defs/id"},
        "agents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "delivery": {"enum": ["required", "optional", "forbidden"]},
        "importance": {"enum": ["essential", "supporting", "background"]},
        "applies_to": {"$ref": "#/$defs/applies_to"},
        "reason": {"$ref": "#/$defs/plain_text"}
      },
      "additionalProperties": false
    }
  }
}

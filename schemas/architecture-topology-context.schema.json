{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/architecture-topology-context.schema.json",
  "title": "Deployable workloads the architecture component inventory must account for",
  "description": "Bounded projection of the deployment topology in .deployment-inventory.json. One row per workload name; zones are qualified by platform so a compose network and a Kubernetes namespace of the same name stay distinct. The architecture analyst maps every row to a component or declares it unmodelled with a reason.",
  "type": "object",
  "required": ["schema_version", "source", "limits", "workloads"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "required": ["artifact_path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "artifact_path": {"const": ".deployment-inventory.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_workloads", "max_definitions", "original_workloads", "omitted_workloads"],
      "additionalProperties": false,
      "properties": {
        "max_workloads": {"const": 128},
        "max_definitions": {"const": 4},
        "original_workloads": {"type": "integer", "minimum": 0, "maximum": 100000},
        "omitted_workloads": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "workloads": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["name", "zones", "zone_bridging", "definitions"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "zones": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_zone"}},
          "zone_bridging": {"type": "boolean"},
          "definitions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["platform", "source", "line"],
              "additionalProperties": false,
              "properties": {
                "platform": {"enum": ["compose", "kubernetes", "openshift"]},
                "kind": {"type": "string", "maxLength": 40},
                "source": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
                "line": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "qualified_zone": {"type": "string", "pattern": "^(?:compose|kubernetes|openshift):.+$", "maxLength": 140}
  }
}

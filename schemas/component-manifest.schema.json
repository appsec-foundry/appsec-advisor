{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivered staging composition inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualification", "lock_sha256", "components", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "qualification": {"const": "unqualified-staging"},
    "lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "components": {"type": "array", "minItems": 2, "maxItems": 256, "items": {"$ref": "components-lock.schema.json#/$defs/component"}},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 20000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "size", "component"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0, "maximum": 268435456},
          "component": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
        }
      }
    }
  }
}

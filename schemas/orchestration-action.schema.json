{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/orchestration-action.schema.json",
  "title": "Threat-model orchestration action",
  "type": "object",
  "required": ["schema_version", "action"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "action": {
      "enum": [
        "abort",
        "complete",
        "decision_required",
        "dispatch_agent",
        "dispatch_parallel",
        "load_runtime",
        "reject",
        "run_gate",
        "start_watchdog",
        "stop_watchdog"
      ]
    },
    "mode": {
      "enum": ["full", "rebuild", "rerender"]
    },
    "stage": {
      "type": "string",
      "enum": ["stage1", "stage1a", "stage1b", "stage1c", "stage1d", "stage2", "stage3", "stage4", "complete"]
    },
    "runtime": {
      "enum": ["thin-full", "thin-rerender"]
    },
    "instruction_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "task_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "preflight_status": {
      "type": "string",
      "maxLength": 500
    },
    "run_plan": {
      "type": "string",
      "maxLength": 10000
    },
    "session_model": {
      "type": "string",
      "maxLength": 200
    },
    "orchestrator_recommended_model": {
      "type": "string",
      "maxLength": 200
    },
    "orchestrator_recommendation_reason": {
      "type": "string",
      "maxLength": 1000
    },
    "orchestrator_prompt_needed": {
      "type": "boolean"
    },
    "config_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "dispatch_values": {
      "type": "object",
      "maxProperties": 80,
      "propertyNames": {
        "enum": [
          "actor_discovery_model",
          "analysis_version",
          "architect_model",
          "architect_review",
          "assessment_depth",
          "business_context_source",
          "check_requirements",
          "compat_label",
          "config_scanner_model",
          "context_resolver_model",
          "diagram_depth",
          "evidence_verifier_max_findings",
          "evidence_verifier_model",
          "enrich_arch_fragments",
          "estimate_source",
          "estimate_stage1_min",
          "estimate_stage2_min",
          "estimate_stage3_min",
          "estimate_stage4_min",
          "estimate_total_pretty",
          "invocation_args",
          "keep_runtime_files",
          "max_cost_usd",
          "max_repair_iterations",
          "max_stride_components",
          "max_wall_time_seconds",
          "merger_model",
          "orchestrator_model",
          "org_profile_path",
          "output_dir",
          "pentest_format",
          "pentest_target",
          "plugin_root",
          "plugin_version",
          "qa_content_model",
          "qa_depth",
          "qa_routine_model",
          "quiet",
          "reasoning_label",
          "reasoning_model",
          "rebuild",
          "recon_scanner_model",
          "renderer_model",
          "refresh_actor_discovery",
          "repo_root",
          "requirements_url_override",
          "reuse_recon_eligible",
          "run_id",
          "scan_manifest",
          "scope",
          "skip_abuse_case_verification",
          "skip_attack_paths_authoring",
          "skip_attack_walkthroughs",
          "skip_business_context",
          "skip_qa",
          "slug",
          "stride_model",
          "stride_concurrency",
          "stride_profile",
          "stride_turns_complex",
          "stride_turns_moderate",
          "stride_turns_simple",
          "total_stages",
          "tracing",
          "triage_model",
          "verbose",
          "write_html",
          "write_pdf",
          "write_pentest_tasks",
          "write_sarif",
          "write_threatdragon",
          "write_yaml",
          "abuse_verifier_model"
        ]
      },
      "properties": {
        "scope": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "stride_profile": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 50
    },
    "renderer_profile": {
      "enum": ["ms-only", "parallel", "full"]
    },
    "semantic_role": {
      "$ref": "#/$defs/semantic_role"
    },
    "next_boundary": {
      "type": "string",
      "enum": [
        "context-v2-post-recon",
        "context-v2-post-actors",
        "context-v2-post-architecture",
        "context-v2-post-boundary",
        "context-v2-prepare-stride",
        "context-v2-post-stride",
        "context-v2-post-merge",
        "context-v2-post-evidence",
        "context-v2-post-triage",
        "context-v2-finalize",
        "finalize-abuse"
      ]
    },
    "dispatch_jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/dispatch_job"
      }
    },
    "artifact_receipts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifact_receipt"
      }
    },
    "context_plan": {
      "$ref": "#/$defs/context_plan_reference"
    },
    "unresolved_decision_keys": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
      }
    },
    "candidate_titles": {
      "description": "Short display titles keyed by candidate id, for dispatch labels. Advisory: a dispatcher falls back to the bare id when an entry is absent.",
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 60
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "abort"
          }
        }
      },
      "then": {
        "required": ["reason", "exit_code"]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "load_runtime"
          }
        }
      },
      "then": {
        "required": ["mode", "runtime", "instruction_file", "reason"]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "dispatch_agent"
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "stage",
          "instruction_file",
          "config_path",
          "dispatch_values"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "dispatch_parallel"
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "stage",
          "instruction_file",
          "config_path",
          "dispatch_values"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "complete"
          }
        }
      },
      "then": {
        "required": ["mode", "stage", "instruction_file", "config_path", "dispatch_values"],
        "properties": {
          "stage": {
            "const": "complete"
          }
        }
      }
    }
  ],
  "$defs": {
    "relative_artifact_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "semantic_role": {
      "enum": [
        "actor_discoverer",
        "abuse_case_verifier",
        "architecture_analyst",
        "config_scanner",
        "context_resolver",
        "control_analyst",
        "evidence_verifier",
        "post_stride_synthesizer",
        "recon_scanner",
        "stride_analyzer",
        "threat_merger",
        "triage_validator",
        "trust_boundary_analyst"
      ]
    },
    "dispatch_job": {
      "type": "object",
      "required": [
        "schema_version",
        "job_id",
        "semantic_role",
        "agent_type",
        "model",
        "input_artifacts",
        "output_artifacts",
        "unresolved_decision_keys"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "component_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Controller-owned attempt identity for retryable STRIDE jobs."
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^(AC-T|AC|ORG-AC|REPO-AC)-[0-9]{3,}$"
        },
        "semantic_role": {
          "$ref": "#/$defs/semantic_role"
        },
        "agent_type": {
          "enum": [
            "appsec-advisor:appsec-actor-discoverer",
            "appsec-advisor:appsec-abuse-case-verifier",
            "appsec-advisor:appsec-architecture-analyst",
            "appsec-advisor:appsec-config-scanner",
            "appsec-advisor:appsec-context-resolver",
            "appsec-advisor:appsec-control-analyst",
            "appsec-advisor:appsec-evidence-verifier",
            "appsec-advisor:appsec-post-stride-synthesizer",
            "appsec-advisor:appsec-recon-scanner",
            "appsec-advisor:appsec-stride-analyzer-v2",
            "appsec-advisor:appsec-threat-merger",
            "appsec-advisor:appsec-triage-validator",
            "appsec-advisor:appsec-trust-boundary-analyst"
          ]
        },
        "model": {
          "enum": ["sonnet", "opus", "haiku"]
        },
        "analysis_depth": {
          "enum": ["full", "light"],
          "description": "Resolved per-component STRIDE depth shown in dispatch and progress labels."
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "sampling_required": {
          "type": "boolean"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "estimated_threat_count": {
          "enum": ["low", "moderate", "high"]
        },
        "lens_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["agentic", "llm", "mobile", "spa", "supply-chain"]
          }
        },
        "evidence_bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "taxonomy_slice_path": {
          "$ref": "#/$defs/relative_artifact_path",
          "pattern": "^\\.taxonomy-slices/[a-z0-9][a-z0-9-]{0,99}/threat-category-taxonomy\\.yaml$"
        },
        "taxonomy_slice_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_plan_path": {
          "$ref": "#/$defs/relative_artifact_path",
          "pattern": "^\\.dispatch-context/[a-z0-9][a-z0-9-]{0,99}/context-plan\\.json$"
        },
        "context_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repository_projection_path": {
          "$ref": "#/$defs/relative_artifact_path",
          "pattern": "^\\.dispatch-context/[a-z0-9][a-z0-9-]{0,99}/repository-roots\\.json$"
        },
        "repository_projection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "business_context_path": {
          "$ref": "#/$defs/relative_artifact_path",
          "pattern": "^\\.dispatch-context/[a-z0-9][a-z0-9-]{0,99}/business-context\\.json$"
        },
        "business_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "llm_policy_path": {
          "$ref": "#/$defs/relative_artifact_path",
          "pattern": "^\\.dispatch-context/[a-z0-9][a-z0-9-]{0,99}/llm-policy\\.json$"
        },
        "llm_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "architecture_context_path": {
          "$ref": "#/$defs/relative_artifact_path",
          "pattern": "^\\.dispatch-context/[a-z0-9][a-z0-9-]{0,99}/architecture-context\\.json$"
        },
        "architecture_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "security_context_projections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["context_id", "artifact_path", "sha256"],
            "properties": {
              "context_id": {
                "enum": [
                  "actors.component_context",
                  "controls.component_context",
                  "prior_run.component_findings",
                  "requirements.component_context",
                  "threats.known_threats",
                  "trust_boundaries.component_context"
                ]
              },
              "artifact_path": {
                "$ref": "#/$defs/relative_artifact_path",
                "pattern": "^\\.dispatch-context/[a-z0-9][a-z0-9-]{0,99}/(?:actors|controls|known-threats|prior-findings|requirements|trust-boundaries)-context\\.json$"
              },
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "context_delivery_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          }
        },
        "input_artifacts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative_artifact_path"
          }
        },
        "output_artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative_artifact_path"
          }
        },
        "unresolved_decision_keys": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "semantic_role": {"const": "stride_analyzer"}
            },
            "required": ["semantic_role"]
          },
          "then": {
            "required": [
              "component_id",
              "attempt",
              "analysis_depth",
              "max_turns",
              "sampling_required",
              "file_count",
              "estimated_threat_count",
              "lens_ids",
              "evidence_bundle_sha256",
              "taxonomy_slice_path",
              "taxonomy_slice_sha256",
              "context_plan_path",
              "context_plan_sha256"
            ],
            "properties": {
              "output_artifacts": {
                "maxItems": 1,
                "items": {
                  "pattern": "^\\.stride-attempts/[a-z0-9][a-z0-9-]{0,99}\\.attempt-[1-5]\\.json$"
                }
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["repository_projection_path"]},
                {"required": ["repository_projection_sha256"]},
                {"required": ["business_context_path"]},
                {"required": ["business_context_sha256"]},
                {"required": ["architecture_context_path"]},
                {"required": ["architecture_context_sha256"]},
                {"required": ["security_context_projections"]}
              ]
            }
          }
        },
        {
          "if": {"required": ["repository_projection_path"]},
          "then": {"required": ["repository_projection_sha256"]}
        },
        {
          "if": {"required": ["repository_projection_sha256"]},
          "then": {"required": ["repository_projection_path"]}
        },
        {
          "if": {"required": ["business_context_path"]},
          "then": {"required": ["business_context_sha256"]}
        },
        {
          "if": {"required": ["business_context_sha256"]},
          "then": {"required": ["business_context_path"]}
        },
        {
          "if": {"required": ["architecture_context_path"]},
          "then": {"required": ["architecture_context_sha256"]}
        },
        {
          "if": {"required": ["architecture_context_sha256"]},
          "then": {"required": ["architecture_context_path"]}
        },
        {
          "if": {
            "properties": {"semantic_role": {"const": "abuse_case_verifier"}},
            "required": ["semantic_role"]
          },
          "then": {"required": ["candidate_id"]}
        }
      ],
      "additionalProperties": false
    },
    "artifact_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_path",
        "schema_id",
        "sha256",
        "record_count",
        "validation_status"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "artifact_path": {
          "$ref": "#/$defs/relative_artifact_path"
        },
        "schema_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "validation_status": {
          "const": "valid"
        }
      },
      "additionalProperties": false
    },
    "context_plan_reference": {
      "type": "object",
      "required": [
        "artifact_path",
        "receipt_path",
        "sha256",
        "receipt_sha256",
        "revision",
        "action_id"
      ],
      "properties": {
        "artifact_path": {"const": ".context-routing-plan.json"},
        "receipt_path": {"const": ".context-routing-plan.receipt.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 4096},
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        }
      },
      "additionalProperties": false
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 8192
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}

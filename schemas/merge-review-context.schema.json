{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/merge-review-context.schema.json",
  "title": "Bounded semantic threat-merge review context",
  "type": "object",
  "required": [
    "schema_version",
    "source_artifact",
    "source_sha256",
    "candidate_group_count",
    "candidate_groups",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_artifact": { "const": ".merge-candidates.json" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_group_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "candidate_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["group_id", "group_key", "member_count", "members"],
        "properties": {
          "group_id": { "type": "string", "pattern": "^GE?-[a-f0-9]{8}$" },
          "group_key": { "enum": ["cwe_stride", "endpoint_family"] },
          "member_count": { "type": "integer", "minimum": 2, "maximum": 256 },
          "members": {
            "type": "array",
            "minItems": 2,
            "maxItems": 256,
            "items": { "type": "object" }
          },
          "cwe": { "type": ["string", "null"], "maxLength": 64 },
          "stride": { "type": ["string", "null"], "maxLength": 64 },
          "endpoint": { "type": "string", "maxLength": 500 },
          "cwe_family": { "type": "string", "maxLength": 100 }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "required": ["serialized_bytes", "estimated_tokens"],
      "properties": {
        "serialized_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "estimated_tokens": { "type": "integer", "minimum": 1, "maximum": 65536 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/stride-run-llm-policy.schema.json",
  "title": "Organization LLM policy projected for one STRIDE component",
  "description": "What the organization allows a language model to receive and to do. Projected per component so it rides the same receipt discipline as every other admitted input; the content is identical across components of a run. Absent when the organization declared no policy — the analyzer then leaves the two policy questions unanswered instead of guessing.",
  "type": "object",
  "required": ["schema_version", "component_id", "source", "attributes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "component_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "source": { "const": "org-profile-llm-policy-v1" },
    "attributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "permitted_data_classes": { "$ref": "#/$defs/policy_list" },
        "approval_required_actions": { "$ref": "#/$defs/policy_list" }
      }
    }
  },
  "$defs": {
    "policy_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    }
  }
}

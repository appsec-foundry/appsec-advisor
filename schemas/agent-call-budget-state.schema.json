{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/agent-call-budget-state.schema.json",
  "title": "Transient call-scoped Agent budget telemetry",
  "type": "object",
  "required": ["schema_version", "calls"],
  "properties": {
    "schema_version": {"const": 2},
    "calls": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {"$ref": "#/$defs/call"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "call": {
      "type": "object",
      "required": [
        "agent_call_id", "sid", "agent", "agent_type", "turns", "max_turns",
        "warn_emitted", "critical_emitted", "max_emitted", "first_seen"
      ],
      "properties": {
        "agent_call_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
        "sid": {"type": "string", "maxLength": 8},
        "agent": {"type": "string", "minLength": 1, "maxLength": 100},
        "agent_type": {"type": "string", "minLength": 1, "maxLength": 256},
        "action_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
        "job_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
        "component_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
        "attempt": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "turns": {"type": "integer", "minimum": 0},
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 1000},
        "warn_emitted": {"type": "boolean"},
        "critical_emitted": {"type": "boolean"},
        "max_emitted": {"type": "boolean"},
        "first_seen": {"type": "integer", "minimum": 0},
        "last_seen": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}

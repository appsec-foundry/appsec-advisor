{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/multi-repo-controls.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_scope_sha256",
    "component_inventory_fingerprint",
    "security_controls"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "component_inventory_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "security_controls": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "control",
          "effectiveness",
          "component_ids",
          "evidence",
          "assessment"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "control": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mechanism",
              "primitive",
              "cross-cutting",
              "lifecycle",
              "surface",
              "summary",
              "not_applicable"
            ]
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "section_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "type": [
              "string",
              "null"
            ]
          },
          "main_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "controls_covered": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "implemented_controls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "assessment": {
            "type": [
              "string",
              "null"
            ]
          },
          "implementation": {
            "type": [
              "string",
              "null"
            ]
          },
          "effectiveness": {
            "type": "string",
            "enum": [
              "Adequate",
              "Partial",
              "Weak",
              "Unsafe",
              "Missing"
            ]
          },
          "component_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"
            }
          }
        }
      }
    }
  }
}

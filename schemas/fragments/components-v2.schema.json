{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/fragments/components-v2.schema.json",
  "title": "Repository-qualified component inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_scope_sha256",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "paths",
          "tier",
          "repository_ids"
        ],
        "properties": {
          "id": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/id"
          },
          "name": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/name"
          },
          "description": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/description"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20000,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/source_path"
            },
            "description": "Exact captured source files, qualified by admitted repository and content hash."
          },
          "tier": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/tier"
          },
          "complexity": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/complexity"
          },
          "framework": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/framework"
          },
          "language": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/language"
          },
          "deployment_zones": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/deployment_zones"
          },
          "sensitive_data": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "basis",
                "handling",
                "evidence"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "category": {
                        "const": "business-data"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "basis": {
                        "const": "declared"
                      }
                    }
                  }
                }
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "credentials",
                    "personal-data",
                    "payment-data",
                    "secrets",
                    "business-data"
                  ]
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "declared"
                  ]
                },
                "handling": {
                  "type": "string",
                  "enum": [
                    "stores",
                    "processes",
                    "transmits"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              }
            }
          },
          "capabilities": {
            "type": "array",
            "maxItems": 8,
            "description": "Evidenced security-relevant functions of this component (data/security-capabilities.yaml). A capability is not a finding and carries no risk rating.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capability",
                "evidence"
              ],
              "properties": {
                "capability": {
                  "type": "string",
                  "enum": [
                    "file-upload",
                    "code-evaluation",
                    "url-fetch",
                    "xml-parsing",
                    "template-rendering",
                    "llm-calls",
                    "llm-tools",
                    "rag-retrieval",
                    "rag-ingestion",
                    "agent-memory",
                    "agent-delegation",
                    "mcp-client",
                    "mcp-server",
                    "token-issuer",
                    "jwt-issuer",
                    "mfa-verifier",
                    "oauth-client",
                    "oidc-client",
                    "saml-service-provider",
                    "websocket-endpoint",
                    "graphql-endpoint",
                    "payment-processing",
                    "email-sending",
                    "admin-functions",
                    "blockchain-client",
                    "background-jobs"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              }
            }
          },
          "handles_sensitive_data": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/handles_sensitive_data"
          },
          "workloads": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/workloads"
          },
          "workload_zones": {
            "$ref": "https://appsec-advisor/schemas/fragments/components.schema.json#/properties/components/items/properties/workload_zones"
          },
          "deployment_evidence": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "description": "Where each listed workload is defined in deployment configuration. Derived by component-inventory finalization; lets a component without own source files cite its service definition."
          },
          "repository_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^repo-[a-f0-9]{16}$"
            }
          },
          "origin": {
            "enum": [
              "reconciliation"
            ]
          },
          "local_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  },
  "$defs": {
    "source_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "path",
        "sha256"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "pattern": "^repo-[a-f0-9]{16}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "repository_id",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "repository_id": {
          "type": "string",
          "pattern": "^repo-[a-f0-9]{16}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/fragments/trust-boundaries.schema.json",
  "title": "Normalized Phase 7 trust-boundary sidecar",
  "description": "Strict v2 output of scripts/prepare_trust_boundary_context.py. Phase 7 may author legacy or provisional input, but only this normalized shape is consumed semantically.",
  "type": "object",
  "required": ["schema_version", "trust_boundaries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "trust_boundaries": {
      "type": "array",
      "items": {"$ref": "#/$defs/trust_boundary"}
    }
  },
  "$defs": {
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/]|[a-zA-Z][a-zA-Z0-9+.-]*://)|(?:^|/)\\.\\.(?:/|$)"}
        },
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "trust_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "assumption",
        "evidence",
        "confidence",
        "resolution_status",
        "sources"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^tb-\\d+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "from": {"type": "string", "minLength": 1, "maxLength": 128},
        "to": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {
          "type": "string",
          "enum": ["network", "process", "identity", "privilege", "tenant", "data-origin", "third-party", "build"],
          "description": "Authored/wire taxonomy. Retained as the sole input vocabulary and for display; `surface` and `transition` are derived from it and are what the pipeline branches on."
        },
        "surface": {
          "type": "string",
          "enum": ["network", "in-process", "build-pipeline"],
          "description": "HOW the crossing happens. Derived from `kind`; never authored."
        },
        "transition": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "items": {"type": "string", "enum": ["identity", "privilege", "tenant", "data-origin", "operator"]},
          "description": "WHAT changes across the crossing. Derived from `kind`; empty means an enforcement interface without a trust transition."
        },
        "enforcement_point": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "The single control that enforces this crossing, carried through from the candidate so the consolidation decision stays auditable. Generic values are dropped during promotion."
        },
        "confidence_basis": {
          "type": "string",
          "enum": ["analyst", "route-evidence"],
          "description": "Present only on `confirmed` rows: whether the analyst inspected the evidence or a deterministic route-evidence check upgraded it."
        },
        "covers_components": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 24,
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": "Components absorbed when crossings were consolidated. Treated as adjacent to this boundary by dispatch, reference validation and ingress elevation."
        },
        "assumption": {"type": "string", "minLength": 1, "maxLength": 240},
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": {"$ref": "#/$defs/evidence_location"}
        },
        "confidence": {"type": "string", "enum": ["confirmed", "inferred", "unknown"]},
        "resolution_status": {"type": "string", "enum": ["resolved", "unresolved", "conflicted"]},
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["detected", "repo-declared", "legacy"]}
        },
        "declaration_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        }
      },
      "allOf": [
        {
          "if": {"properties": {"resolution_status": {"const": "resolved"}}, "required": ["resolution_status"]},
          "then": {
            "required": ["from", "to"],
            "properties": {
              "from": {"pattern": "^(?:external|[A-Za-z][A-Za-z0-9-]{0,127})$"},
              "to": {"pattern": "^(?:external|[A-Za-z][A-Za-z0-9-]{0,127})$"}
            }
          }
        },
        {
          "if": {"required": ["declaration_key"]},
          "then": {"properties": {"sources": {"contains": {"const": "repo-declared"}}}}
        }
      ]
    }
  }
}

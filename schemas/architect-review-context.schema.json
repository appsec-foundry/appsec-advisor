{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/architect-review-context.schema.json",
  "title": "Controller-owned bounded architect review packets",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_findings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_packet_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "max_packets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "max_findings",
        "max_packet_bytes",
        "max_packets"
      ],
      "additionalProperties": false
    },
    "packets": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/packet"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t_id": {
            "type": "string",
            "pattern": "^T-[0-9]{3,}$"
          },
          "reason": {
            "enum": [
              "refuted",
              "oversized",
              "packet_limit"
            ]
          }
        },
        "required": [
          "t_id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "input_sha256",
    "context_sha256",
    "policy_sha256",
    "limits",
    "packets",
    "excluded"
  ],
  "additionalProperties": false,
  "$defs": {
    "packet": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "packet_id": {
          "type": "string",
          "pattern": "^packet-[0-9]{4,}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "component_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "context": {
          "type": "object",
          "properties": {
            "business": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://appsec-advisor/schemas/stride-analyst-context.schema.json#/$defs/business_context"
                }
              ]
            },
            "architecture": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://appsec-advisor/schemas/stride-analyst-context.schema.json#/$defs/architecture_context"
                }
              ]
            },
            "controls": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://appsec-advisor/schemas/stride-analyst-context.schema.json#/$defs/text_or_list"
                }
              ]
            }
          },
          "required": [
            "business",
            "architecture",
            "controls"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "finding": {
                "allOf": [
                  {
                    "$ref": "https://appsec-advisor/schemas/threats-merged.schema.yaml#/properties/threats/items"
                  }
                ],
                "properties": {
                  "scenario": {
                    "$ref": "https://appsec-advisor/schemas/stride.schema.yaml#/$defs/normal/properties/threats/items/properties/scenario"
                  },
                  "evidence_summary": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mitigation_title": {
                    "$ref": "https://appsec-advisor/schemas/stride.schema.yaml#/$defs/normal/properties/threats/items/properties/mitigation_title"
                  },
                  "remediation": {
                    "$ref": "https://appsec-advisor/schemas/stride.schema.yaml#/$defs/normal/properties/threats/items/properties/remediation"
                  },
                  "risk_reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "likelihood_reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "impact_reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rationale": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "threat_category_id": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "mitigation_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^M-[0-9]{3,}[a-z]?$"
                    },
                    "maxItems": 32
                  },
                  "controls_in_place": {
                    "$ref": "https://appsec-advisor/schemas/stride.schema.yaml#/$defs/normal/properties/threats/items/properties/controls_in_place"
                  },
                  "attack_steps": {
                    "$ref": "https://appsec-advisor/schemas/stride.schema.yaml#/$defs/normal/properties/threats/items/properties/attack_steps"
                  },
                  "violated_requirements": {
                    "$ref": "https://appsec-advisor/schemas/stride.schema.yaml#/$defs/normal/properties/threats/items/properties/violated_requirements"
                  }
                },
                "unevaluatedProperties": false
              },
              "risk_ceiling": {
                "enum": [
                  "Critical",
                  "High",
                  "Medium",
                  "Low"
                ]
              },
              "ordinary_priority": {
                "enum": [
                  "P1",
                  "P2",
                  "P3",
                  "P4"
                ]
              }
            },
            "required": [
              "finding",
              "risk_ceiling",
              "ordinary_priority"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "packet_id",
        "input_sha256",
        "context_sha256",
        "policy_sha256",
        "component_id",
        "context",
        "findings"
      ],
      "additionalProperties": false
    }
  }
}

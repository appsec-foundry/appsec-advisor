{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/receipt-verification.schema.json",
  "title": "Completed receipt verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "action_sha256",
    "plan_sha256",
    "plan_receipt_sha256",
    "receipts_sha256",
    "artifact_count",
    "verified_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "action_id": {"type": "string", "pattern": "^[a-z0-9_-]+:[a-f0-9]{16}$"},
    "action_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "receipts_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "verified_at": {"type": "string", "format": "date-time"}
  }
}

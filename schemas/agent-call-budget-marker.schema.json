{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/agent-call-budget-marker.schema.json",
  "title": "Transient call-scoped Agent budget markers",
  "type": "array",
  "maxItems": 256,
  "items": {
    "type": "object",
    "required": ["agent_call_id", "sid", "agent", "agent_type", "turns", "max", "pct"],
    "properties": {
      "agent_call_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
      "sid": {"type": "string", "maxLength": 8},
      "agent": {"type": "string", "minLength": 1, "maxLength": 100},
      "agent_type": {"type": "string", "minLength": 1, "maxLength": 256},
      "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
      "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
      "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
      "attempt": {"type": "integer", "minimum": 1, "maximum": 5},
      "turns": {"type": "integer", "minimum": 0},
      "max": {"type": "integer", "minimum": 1, "maximum": 1000},
      "pct": {"type": "number", "minimum": 0}
    },
    "additionalProperties": false
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/architect-review-job.schema.json",
  "title": "Architect review agent job",
  "description": "One controller-written job: the component-local review packets one architect_reviewer agent reviews.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^architect-review:[A-Za-z0-9][A-Za-z0-9._-]{0,99}:[0-9]{1,3}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "component_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "packets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "properties": {
          "packet_id": {
            "type": "string",
            "pattern": "^packet-[0-9]{4,}$"
          }
        },
        "required": [
          "packet_id"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "run_id",
    "component_id",
    "packets"
  ],
  "additionalProperties": false
}

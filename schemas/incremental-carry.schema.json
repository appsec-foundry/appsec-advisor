{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/incremental-carry.schema.json",
  "title": "Incremental STRIDE carry plan",
  "description": "Which components an incremental run carried from the previous model and why every other component was re-analyzed (decision IN-5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_commit", "changed_file_count", "carried", "reanalyzed"],
  "properties": {
    "schema_version": { "const": 1 },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "changed_file_count": { "type": "integer", "minimum": 0 },
    "carried": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "reanalyzed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "reason"],
        "properties": {
          "component_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "reason": {
            "type": "string",
            "enum": [
              "new_component",
              "paths_changed",
              "requirements_changed",
              "no_prior_output",
              "hash_mismatch",
              "files_changed",
              "contract_rejected"
            ]
          }
        }
      }
    }
  }
}

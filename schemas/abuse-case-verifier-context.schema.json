{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/abuse-case-verifier-context.schema.json",
  "title": "Bounded per-candidate abuse-case verifier input",
  "type": "object",
  "required": ["schema_version", "source", "limits", "candidate"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "required": ["artifact_path", "sha256", "candidate_id", "match_count"],
      "properties": {
        "artifact_path": {"const": ".abuse-case-matches.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "match_count": {"type": "integer", "minimum": 1, "maximum": 10000}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["max_chain_steps", "max_patterns_per_field", "max_source_window_lines", "max_source_chars", "source_chars", "max_bytes", "serialized_bytes"],
      "properties": {
        "max_chain_steps": {"const": 16},
        "max_patterns_per_field": {"const": 32},
        "max_source_window_lines": {"const": 17},
        "max_source_chars": {"const": 32768},
        "source_chars": {"type": "integer", "minimum": 0, "maximum": 32768},
        "max_bytes": {"const": 65536},
        "serialized_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
      },
      "additionalProperties": false
    },
    "candidate": {
      "if": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "descriptive"}}},
      "then": {"$ref": "#/$defs/descriptive_candidate"},
      "else": {"$ref": "#/$defs/probe_candidate"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "probe_candidate": {
      "type": "object",
      "required": ["abuse_case_id", "title", "source", "structural_verdict", "reason", "attacker", "goal", "chain", "step_matches"],
      "properties": {
        "abuse_case_id": {"$ref": "#/$defs/candidate_id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "source": {"enum": ["mandatory", "discovered"]},
        "structural_verdict": {"enum": ["candidate", "partial_candidate"]},
        "reason": {"type": ["string", "null"], "maxLength": 2000},
        "attacker": {
          "type": "object",
          "required": ["actor_id", "initial_access", "prerequisite"],
          "properties": {
            "actor_id": {"type": "string", "minLength": 1, "maxLength": 200},
            "initial_access": {"enum": ["unauthenticated", "authenticated_low_priv", "authenticated_high_priv", "physical"]},
            "prerequisite": {"type": ["string", "null"], "maxLength": 2000}
          },
          "additionalProperties": false
        },
        "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "chain": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/chain_step"}},
        "step_matches": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/step_match"}}
      },
      "additionalProperties": false
    },
    "prose": {"type": "string", "minLength": 1, "maxLength": 600},
    "prose_list": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/prose"}},
    "descriptive_candidate": {
      "description": "A plain-language business case. The verifier binds its steps to this repository's code; preselected sources and related findings are deterministic hints, not conclusions.",
      "type": "object",
      "required": ["abuse_case_id", "kind", "title", "structural_verdict", "reason", "requested", "actor", "initial_access", "prerequisites", "goal", "boundary", "steps", "expected_controls", "evidence", "exclusions", "open_questions", "preselected_sources", "related_findings"],
      "properties": {
        "abuse_case_id": {"$ref": "#/$defs/candidate_id"},
        "kind": {"const": "descriptive"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "structural_verdict": {"const": "candidate"},
        "reason": {"type": ["string", "null"], "maxLength": 2000},
        "requested": {"type": "boolean"},
        "actor": {"type": ["string", "null"], "minLength": 1, "maxLength": 600},
        "initial_access": {"enum": ["unauthenticated", "authenticated_low_priv", "authenticated_high_priv", "physical", null]},
        "prerequisites": {"type": ["string", "null"], "maxLength": 600},
        "goal": {"type": ["string", "null"], "minLength": 1, "maxLength": 600},
        "boundary": {"type": ["string", "null"], "minLength": 1, "maxLength": 600},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["step", "label"],
            "properties": {"step": {"type": "integer", "minimum": 1, "maximum": 8}, "label": {"$ref": "#/$defs/prose"}},
            "additionalProperties": false
          }
        },
        "expected_controls": {"$ref": "#/$defs/prose_list"},
        "evidence": {"$ref": "#/$defs/prose_list"},
        "exclusions": {"$ref": "#/$defs/prose_list"},
        "open_questions": {"$ref": "#/$defs/prose_list"},
        "preselected_sources": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "related_findings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id", "title", "cwe", "file", "line", "source_window"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 100},
              "title": {"type": "string", "minLength": 1, "maxLength": 500},
              "cwe": {"type": ["string", "null"], "maxLength": 40},
              "file": {"type": "string", "minLength": 1, "maxLength": 1000},
              "line": {"type": ["integer", "null"], "minimum": 1},
              "source_window": {"$ref": "#/$defs/source_window"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "candidate_id": {"type": "string", "pattern": "^(AC-T|AC|ORG-AC|REPO-AC)-[0-9]{3,}$"},
    "nullable_string": {"type": ["string", "null"], "maxLength": 2000},
    "string_list": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "evidence": {
      "type": ["object", "null"],
      "properties": {
        "file": {"type": "string", "minLength": 1, "maxLength": 1000},
        "line": {"type": ["integer", "null"], "minimum": 1}
      },
      "required": ["file", "line"],
      "additionalProperties": false
    },
    "source_window": {
      "type": ["object", "null"],
      "properties": {
        "file": {"type": "string", "minLength": 1, "maxLength": 1000},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "content": {"type": "string", "maxLength": 32768},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["file", "start_line", "end_line", "content", "content_sha256"],
      "additionalProperties": false
    },
    "finding": {
      "type": ["object", "null"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
        "stride": {"enum": ["Spoofing", "Tampering", "Repudiation", "Information Disclosure", "Denial of Service", "Elevation of Privilege"]},
        "severity": {"enum": ["Critical", "High", "Medium", "Low"]},
        "mitigation_title": {"type": "string", "minLength": 1, "maxLength": 120},
        "remediation": {"type": "string", "minLength": 1, "maxLength": 5000}
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "required": ["entry_points", "sink_patterns", "control_patterns", "control_sufficiency", "anchors"],
      "properties": {
        "entry_points": {
          "type": "object",
          "required": ["endpoint_patterns", "file_hints"],
          "properties": {
            "endpoint_patterns": {"$ref": "#/$defs/string_list"},
            "file_hints": {"$ref": "#/$defs/string_list"}
          },
          "additionalProperties": false
        },
        "sink_patterns": {"allOf": [{"$ref": "#/$defs/string_list"}, {"minItems": 1}]},
        "control_patterns": {"$ref": "#/$defs/string_list"},
        "control_sufficiency": {"enum": ["any", "all"]},
        "anchors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["file", "line_hint", "pattern"],
            "properties": {
              "file": {"type": "string", "minLength": 1, "maxLength": 1000},
              "line_hint": {"type": ["integer", "null"], "minimum": 1},
              "pattern": {"type": "string", "minLength": 1, "maxLength": 1000}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "chain_step": {
      "type": "object",
      "required": ["step", "label", "grants", "requires", "description", "required", "finding", "probe"],
      "properties": {
        "step": {"type": "integer", "minimum": 1, "maximum": 16},
        "label": {"type": "string", "minLength": 1, "maxLength": 500},
        "grants": {"type": "string", "minLength": 1, "maxLength": 500},
        "requires": {"type": ["string", "null"], "maxLength": 500},
        "description": {"$ref": "#/$defs/nullable_string"},
        "required": {"type": "boolean"},
        "finding": {"$ref": "#/$defs/finding"},
        "probe": {"$ref": "#/$defs/probe"}
      },
      "additionalProperties": false
    },
    "step_match": {
      "type": "object",
      "required": ["step", "label", "required", "grants", "requires", "matched", "matched_finding_id", "evidence", "source_window", "match_basis", "controls_found"],
      "properties": {
        "step": {"type": "integer", "minimum": 1, "maximum": 16},
        "label": {"type": "string", "minLength": 1, "maxLength": 500},
        "required": {"type": "boolean"},
        "grants": {"type": "string", "minLength": 1, "maxLength": 500},
        "requires": {"type": ["string", "null"], "maxLength": 500},
        "matched": {"type": "boolean"},
        "matched_finding_id": {"type": ["string", "null"], "maxLength": 100},
        "evidence": {"$ref": "#/$defs/evidence"},
        "source_window": {"$ref": "#/$defs/source_window"},
        "match_basis": {"type": ["string", "null"], "maxLength": 100},
        "controls_found": {"$ref": "#/$defs/string_list"}
      },
      "additionalProperties": false
    }
  }
}

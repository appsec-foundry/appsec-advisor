{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/stride-component-repository-roots.schema.json",
  "title": "Bounded related-repository roots for one STRIDE component",
  "type": "object",
  "required": ["schema_version", "component_id", "source_registry_sha256", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "component_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "source_registry_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["repository_id", "kind", "root"],
        "properties": {
          "repository_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "not": {"const": "primary"}
          },
          "kind": {"const": "related"},
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

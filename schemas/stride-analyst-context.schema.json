{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/stride-analyst-context.schema.json",
  "title": "Bounded per-component semantic context for STRIDE bundle construction",
  "description": "Routing hints are additionally validated against the finalized component paths and repository before publication and bundle construction.",
  "type": "object",
  "propertyNames": { "pattern": "^(?:_stride_profile|[a-z][a-z0-9-]{1,99})$" },
  "properties": {
    "_stride_profile": {
      "oneOf": [
        { "type": "string", "maxLength": 200 },
        { "type": "object", "maxProperties": 20, "additionalProperties": { "$ref": "#/$defs/scalar" } }
      ]
    }
  },
  "additionalProperties": {
    "type": "object",
    "minProperties": 1,
    "maxProperties": 12,
    "properties": {
      "interfaces": { "$ref": "#/$defs/text_or_list" },
      "controls": { "$ref": "#/$defs/text_or_list" },
      "known_secrets": { "$ref": "#/$defs/text_or_list" },
      "known_vulns": { "$ref": "#/$defs/text_or_list" },
      "known_llm_patterns": { "$ref": "#/$defs/text_or_list" },
      "supply_chain_findings": { "$ref": "#/$defs/text_or_list" },
      "estimated_threat_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
      "business_context": { "$ref": "#/$defs/business_context" },
      "architecture_context": { "$ref": "#/$defs/architecture_context" },
      "focus_paths": { "$ref": "#/$defs/routing_input" },
      "exclude_paths": { "$ref": "#/$defs/routing_input" }
    },
    "additionalProperties": false
  },
  "$defs": {
    "scalar": {
      "oneOf": [
        { "type": "string", "maxLength": 1000 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "text_or_list": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 4096 },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      ]
    },
    "routing_input": {
      "description": "Compatibility string-or-list input normalized to literal repository-relative paths before dispatch.",
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
        }
      ]
    },
    "business_context": {
      "description": "Human-readable business and organization facts projected for one component. These values inform scenarios and impact; they do not override repository evidence or severity policy.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 5,
      "properties": {
        "business_purpose": { "$ref": "#/$defs/context_text" },
        "impact_if_compromised": { "$ref": "#/$defs/context_text" },
        "sensitive_assets": { "$ref": "#/$defs/context_list" },
        "security_obligations": { "$ref": "#/$defs/context_list" },
        "security_assumptions": { "$ref": "#/$defs/context_list" }
      },
      "additionalProperties": false
    },
    "architecture_context": {
      "description": "Human-readable security architecture facts projected for one component. These values inform topology and assumptions; they do not prove a control, boundary, threat, or finding.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 5,
      "properties": {
        "security_role": { "$ref": "#/$defs/context_text" },
        "exposed_interfaces": { "$ref": "#/$defs/context_list" },
        "security_dependencies": { "$ref": "#/$defs/context_list" },
        "deployment_constraints": { "$ref": "#/$defs/context_list" },
        "architecture_assumptions": { "$ref": "#/$defs/context_list" }
      },
      "additionalProperties": false
    },
    "context_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "context_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "\\S"
      }
    }
  }
}

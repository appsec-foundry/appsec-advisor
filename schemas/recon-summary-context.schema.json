{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/recon-summary-context.schema.json",
  "title": "Bounded reconnaissance summary projection",
  "type": "object",
  "required": ["schema_version", "source", "limits", "sections"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "required": ["artifact_path", "sha256", "line_count"],
      "properties": {
        "artifact_path": {"const": ".recon-summary.md"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "line_count": {"type": "integer", "minimum": 1, "maximum": 1000000}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["max_sections", "max_retained_lines", "max_line_chars", "retained_lines", "omitted_body_lines", "ordering_key"],
      "properties": {
        "max_sections": {"const": 64},
        "max_retained_lines": {"const": 200},
        "max_line_chars": {"const": 500},
        "retained_lines": {"type": "integer", "minimum": 1, "maximum": 200},
        "omitted_body_lines": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "ordering_key": {"const": "source heading and line order"}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["heading", "level", "lines", "original_body_lines", "omitted_body_lines"],
        "properties": {
          "heading": {"type": "string", "minLength": 1, "maxLength": 200},
          "level": {"type": "integer", "minimum": 1, "maximum": 6},
          "lines": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "original_body_lines": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "omitted_body_lines": {"type": "integer", "minimum": 0, "maximum": 1000000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

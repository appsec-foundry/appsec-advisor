{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/stride-evidence-bundle.schema.json",
  "title": "Bounded per-component STRIDE evidence bundle",
  "type": "object",
  "required": [
    "schema_version",
    "component",
    "repository_state",
    "evidence",
    "source_slices",
    "truncation",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "component": {
      "type": "object",
      "required": ["id", "name", "description", "paths"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "additionalProperties": false
    },
    "repository_state": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "items": {
        "type": "object",
        "required": ["repository_id", "kind", "commit_sha", "dirty_worktree_sha256"],
        "properties": {
          "repository_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "kind": { "enum": ["primary", "related"] },
          "commit_sha": { "type": "string", "pattern": "^(?:[a-f0-9]{40,64}|unversioned)$" },
          "dirty_worktree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "allOf": [
          {
            "if": { "properties": { "repository_id": { "const": "primary" } }, "required": ["repository_id"] },
            "then": { "properties": { "kind": { "const": "primary" } } },
            "else": { "properties": { "kind": { "const": "related" } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "path_routing": {
      "type": "object",
      "required": [
        "focus_paths",
        "exclude_paths",
        "focus_admission",
        "exclude_application",
        "protected_evidence_path_count",
        "protected_evidence_paths_sha256"
      ],
      "properties": {
        "focus_paths": { "$ref": "#/$defs/routing_path_array" },
        "exclude_paths": { "$ref": "#/$defs/routing_path_array" },
        "focus_admission": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "path",
              "status",
              "reason",
              "candidate_files",
              "projected_files",
              "omitted_files",
              "unowned_files",
              "enumeration_truncated"
            ],
            "properties": {
              "path": { "$ref": "#/$defs/routing_path" },
              "status": { "enum": ["admitted", "omitted"] },
              "reason": {
                "enum": [
                  "projected",
                  "partially-projected",
                  "enumeration-budget",
                  "source-budget",
                  "outside-component",
                  "no-readable-files"
                ]
              },
              "candidate_files": { "type": "integer", "minimum": 0, "maximum": 100000 },
              "projected_files": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/repository_path" }
              },
              "omitted_files": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000,
                "description": "Files the component owns that the focus path reached but the projection did not admit, because they were empty or the source-slice and line budgets were already spent. Files outside the component are not omissions and are counted by 'unowned_files' instead; the two plus 'projected_files' make up 'candidate_files'."
              },
              "unowned_files": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000,
                "description": "Files enumerated under the focus path that the component's own path globs do not match. They are dropped from the projection, never added to the bundle; a non-zero value means the component's paths are narrower than its focus scope."
              },
              "enumeration_truncated": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "exclude_application": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["path", "status", "scope", "superseded_by"],
            "properties": {
              "path": { "$ref": "#/$defs/routing_path" },
              "status": { "enum": ["applied", "superseded"] },
              "scope": { "const": "optional-discovery-only" },
              "superseded_by": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/repository_path" },
                "description": "Mandatory or cited evidence paths this exclude would have hidden. Non-empty exactly when status is 'superseded': an exclude is an optional-discovery hint, so it yields to evidence and is dropped from the effective exclude_paths instead of aborting the run."
              }
            },
            "additionalProperties": false
          }
        },
        "protected_evidence_path_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "protected_evidence_paths_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "degraded": {
          "type": "object",
          "description": "Present only when the component was rebuilt without its routing hints because they made the bundle unbuildable. Routing is prioritization, not evidence, so dropping it degrades one component instead of aborting the run — but the drop is recorded here so a degraded bundle stays distinguishable from one that never carried routing.",
          "required": ["reason", "error", "dropped_focus_paths", "dropped_exclude_paths"],
          "properties": {
            "reason": { "const": "routing-hints-dropped" },
            "error": { "type": "string", "minLength": 1, "maxLength": 500 },
            "dropped_focus_paths": { "$ref": "#/$defs/routing_path_array" },
            "dropped_exclude_paths": { "$ref": "#/$defs/routing_path_array" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "interfaces",
        "cross_repo",
        "recon_signals"
      ],
      "properties": {
        "interfaces": { "$ref": "#/$defs/record_array" },
        "cross_repo": { "$ref": "#/$defs/record_array" },
        "recon_signals": { "$ref": "#/$defs/record_array" }
      },
      "additionalProperties": false
    },
    "source_slices": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "repository_id",
          "path",
          "start_line",
          "end_line",
          "signal_kind",
          "content_sha256"
        ],
        "properties": {
          "repository_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "path": { "$ref": "#/$defs/repository_path" },
          "start_line": { "type": "integer", "minimum": 1, "maximum": 10000000 },
          "end_line": { "type": "integer", "minimum": 1, "maximum": 10000000 },
          "signal_kind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "truncation": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "signal_class",
          "original_count",
          "retained_count",
          "omitted_count",
          "cap",
          "ordering_key"
        ],
        "properties": {
          "signal_class": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "original_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "retained_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "omitted_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "cap": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "ordering_key": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "required": ["serialized_bytes", "estimated_tokens", "referenced_source_lines"],
      "properties": {
        "serialized_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "estimated_tokens": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "referenced_source_lines": { "type": "integer", "minimum": 0, "maximum": 400 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "repository_path": {
      "description": "A path to a file that exists in a repository, as the pipeline discovered it. Contained and traversal-free, but otherwise unrestricted: a legal filename may carry any character the filesystem allows, including the glob metacharacters that routing inputs must not use.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {
        "pattern": "^(?:/|[A-Za-z]:[\\\\/]|[A-Za-z][A-Za-z0-9+.-]*://)|(?:^|/)\\.\\.(?:/|$)|\\\\"
      }
    },
    "routing_path": {
      "description": "A literal path a routing hint selects. A repository path that additionally carries no glob metacharacter, because a hint selects one named file or directory rather than a pattern.",
      "allOf": [{ "$ref": "#/$defs/repository_path" }],
      "not": { "pattern": "[*?\\[\\]{}!]" }
    },
    "routing_path_array": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/routing_path" }
    },
    "record_array": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["source", "value", "content_sha256", "truncated"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 200 },
          "value": { "type": "string", "maxLength": 4096 },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "truncated": { "type": "boolean" },
          "original_chars": { "type": "integer", "minimum": 0, "maximum": 10000000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

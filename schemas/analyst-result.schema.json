{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/analyst-result.schema.json",
  "title": "Threat analyst result",
  "description": "Validated, controller-published result of one on-demand threat analysis. Advisory: it states coverage and never claims security approval. Identifiers are job-local and never threat-model identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "input_fingerprint",
    "state",
    "terminal_reason",
    "mode",
    "scope",
    "objects",
    "packages",
    "coverage",
    "summary",
    "findings",
    "scenarios",
    "assumptions",
    "requirement_observations",
    "methodology_observations",
    "questions",
    "limitations",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^aj-[0-9a-f]{32}$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "complete",
        "incomplete",
        "failed",
        "cancelled"
      ]
    },
    "terminal_reason": {
      "type": "string",
      "maxLength": 64
    },
    "mode": {
      "enum": [
        "design",
        "review"
      ]
    },
    "scope": {
      "type": "object"
    },
    "objects": {
      "type": "object"
    },
    "packages": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "sha256",
          "authority",
          "provenance"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted_files",
        "excluded",
        "sources",
        "omitted_questions",
        "question_coverage",
        "required_complete"
      ],
      "properties": {
        "admitted_files": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "array",
          "maxItems": 2000
        },
        "sources": {
          "type": "array",
          "maxItems": 10
        },
        "omitted_questions": {
          "type": "array",
          "maxItems": 1000
        },
        "question_coverage": {
          "type": "array",
          "maxItems": 200
        },
        "required_complete": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "change_relationship",
          "evidence",
          "next_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f-[0-9]{3}$"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s-[0-9]{3}$"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^a-[0-9]{3}$"
          }
        }
      }
    },
    "requirement_observations": {
      "type": "array",
      "maxItems": 30
    },
    "methodology_observations": {
      "type": "array",
      "maxItems": 40
    },
    "questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "asks",
          "why",
          "affects",
          "required",
          "fingerprint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q-[0-9]{3}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 1200
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_calls": {
          "type": "integer",
          "minimum": 0
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}

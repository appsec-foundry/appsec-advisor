{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/analyst-result.schema.json",
  "title": "Threat analyst result",
  "description": "Validated, controller-published result of one on-demand threat analysis. Advisory: it states coverage and never claims security approval. Identifiers are job-local and never threat-model identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "input_fingerprint",
    "state",
    "terminal_reason",
    "mode",
    "scope",
    "objects",
    "packages",
    "coverage",
    "summary",
    "findings",
    "scenarios",
    "assumptions",
    "requirement_observations",
    "methodology_observations",
    "questions",
    "limitations",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^aj-[0-9a-f]{32}$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "complete",
        "incomplete",
        "failed",
        "cancelled"
      ]
    },
    "terminal_reason": {
      "type": "string",
      "maxLength": 64
    },
    "mode": {
      "enum": [
        "design",
        "review",
        "hypothesis"
      ]
    },
    "scope": {
      "type": "object"
    },
    "objects": {
      "type": "object"
    },
    "packages": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "sha256",
          "authority",
          "provenance"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted_files",
        "excluded",
        "sources",
        "omitted_questions",
        "question_coverage",
        "required_complete"
      ],
      "properties": {
        "admitted_files": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "array",
          "maxItems": 2000
        },
        "sources": {
          "type": "array",
          "maxItems": 10
        },
        "omitted_questions": {
          "type": "array",
          "maxItems": 1000
        },
        "question_coverage": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_ref",
              "status",
              "note"
            ],
            "properties": {
              "question_ref": {
                "$ref": "#/$defs/entry_ref"
              },
              "status": {
                "enum": [
                  "answered_from_evidence",
                  "needs_answer",
                  "not_applicable"
                ]
              },
              "note": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "required_complete": {
          "type": "boolean"
        },
        "redacted": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "lines"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relative_path"
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "evidence_requests": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason",
              "status",
              "detail"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relative_path"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "status": {
                "enum": [
                  "admitted",
                  "rejected",
                  "limit_exhausted"
                ]
              },
              "detail": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "change_relationship",
          "evidence",
          "next_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f-[0-9]{3}$"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s-[0-9]{3}$"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^a-[0-9]{3}$"
          }
        }
      }
    },
    "requirement_observations": {
      "type": "array",
      "maxItems": 30
    },
    "methodology_observations": {
      "type": "array",
      "maxItems": 40
    },
    "questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "asks",
          "why",
          "affects",
          "required",
          "fingerprint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q-[0-9]{3}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "question_ref": {
            "$ref": "#/$defs/entry_ref"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 1200
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_calls": {
          "type": "integer",
          "minimum": 0
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "hypothesis_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "explanation",
        "evidence",
        "next_action"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "not_confirmed",
            "unresolved"
          ]
        },
        "explanation": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "next_action": {
          "$ref": "#/$defs/text"
        },
        "steps": {
          "description": "One verdict per numbered step the hypothesis lists (lines starting with '- Step N:'), each with the code it rests on.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "status",
              "note",
              "evidence"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "status": {
                "enum": [
                  "supported",
                  "not_confirmed",
                  "unresolved"
                ]
              },
              "note": {
                "$ref": "#/$defs/text"
              },
              "evidence": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "$ref": "#/$defs/location"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "path",
        "line_start",
        "line_end",
        "excerpt"
      ],
      "properties": {
        "side": {
          "enum": [
            "baseline",
            "proposed"
          ]
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\x00]+$"
    },
    "entry_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}/[a-z0-9][a-z0-9-]{0,63}:[a-z0-9][a-z0-9-]{0,63}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\x00-]"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "hypothesis"
          }
        }
      },
      "then": {
        "required": [
          "hypothesis"
        ],
        "properties": {
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "revision",
              "paths"
            ],
            "properties": {
              "kind": {
                "const": "hypothesis"
              },
              "revision": {
                "$ref": "#/$defs/revision"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\x00-\\x1f\\\\]+$"
                }
              }
            }
          }
        }
      }
    }
  ]
}

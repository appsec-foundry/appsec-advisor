                            "pattern": "\\S"
                          },
                          "effort": {
                            "enum": [
                              "Low",
                              "Medium",
                              "High"
                            ]
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }

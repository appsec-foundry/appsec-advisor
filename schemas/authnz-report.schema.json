{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/authnz-report.schema.json",
  "title": "AuthN/AuthZ review report",
  "description": "Written by agents/appsec-authnz-analyzer.md to $OUTPUT_DIR/.authnz-report.json. scripts/model/authnz_report.py validates it and owns `summary`; the authnz-review skill prints it and scripts/renderers/render_pentest_tasks.py exports its findings.",
  "type": "object",
  "required": ["partial", "analyzed_at", "findings", "chain_findings", "stride_covered"],
  "additionalProperties": false,
  "properties": {
    "signal_dispositions": {
      "type": "array",
      "description": "Deterministic reconciliation of in-scope scanner signals to retained report findings.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sidecar",
          "check_id",
          "file",
          "line",
          "finding_id"
        ],
        "properties": {
          "sidecar": {
            "enum": [
              ".source-auth-findings.json",
              ".authz-confirm-findings.json"
            ]
          },
          "check_id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "finding_id": {
            "$ref": "#/$defs/findingId"
          }
        }
      }
    },
    "partial": {
      "type": "boolean",
      "description": "true until the analyzer has written its last step; a report still partial after the agent returned is incomplete."
    },
    "analyzed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "last_step": { "type": "string", "maxLength": 80 },
    "summary": { "$ref": "#/$defs/summary" },
    "auth_coverage": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/componentCoverage" }
    },
    "chain_findings": { "type": "array", "items": { "$ref": "#/$defs/chain" } },
    "stride_covered": { "type": "array", "items": { "$ref": "#/$defs/strideCovered" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_findings", "critical", "high", "medium", "low", "idor_confirmed", "idor_hypotheses",
        "missing_auth", "jwt_findings", "credential_findings", "privilege_escalation",
        "requirements_annotated", "stride_deduplicated", "chains"
      ],
      "properties": {
        "total_findings": { "$ref": "#/$defs/count" },
        "critical": { "$ref": "#/$defs/count" },
        "high": { "$ref": "#/$defs/count" },
        "medium": { "$ref": "#/$defs/count" },
        "low": { "$ref": "#/$defs/count" },
        "idor_confirmed": { "$ref": "#/$defs/count" },
        "idor_hypotheses": { "$ref": "#/$defs/count" },
        "missing_auth": { "$ref": "#/$defs/count" },
        "jwt_findings": { "$ref": "#/$defs/count" },
        "credential_findings": { "$ref": "#/$defs/count" },
        "privilege_escalation": { "$ref": "#/$defs/count" },
        "requirements_annotated": { "$ref": "#/$defs/count" },
        "stride_deduplicated": { "$ref": "#/$defs/count" },
        "chains": { "$ref": "#/$defs/count" }
      }
    },
    "componentCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_routes", "authenticated", "unauthenticated", "unknown"],
      "properties": {
        "total_routes": { "$ref": "#/$defs/count" },
        "authenticated": { "$ref": "#/$defs/count" },
        "unauthenticated": { "$ref": "#/$defs/count" },
        "unknown": { "$ref": "#/$defs/count" }
      }
    },
    "findingId": { "type": "string", "pattern": "^AZ-[0-9]{3,}$" },
    "cwe": { "type": "string", "pattern": "^CWE-[0-9]+$" },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "root_title", "chain_ids", "impact"],
      "properties": {
        "root_id": { "$ref": "#/$defs/findingId" },
        "root_title": { "type": "string", "minLength": 1 },
        "chain_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/findingId" } },
        "impact": { "type": "string", "minLength": 1 }
      }
    },
    "strideCovered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "cwe", "file", "stride_threat"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "cwe": { "$ref": "#/$defs/cwe" },
        "file": { "type": "string", "minLength": 1 },
        "stride_threat": { "type": "string", "minLength": 1, "description": "Title or id of the STRIDE threat that already covers this weakness." }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "snippet": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "severity", "category", "cwe", "stride", "source", "component_id",
        "evidence", "attack_path", "remediation", "requirement_id", "requirement_url"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/findingId" },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["Critical", "High", "Medium", "Low"] },
        "category": { "enum": ["idor", "route_auth", "mass_assign", "jwt", "credential"] },
        "cwe": { "$ref": "#/$defs/cwe" },
        "stride": { "enum": ["Elevation of Privilege", "Spoofing", "Information Disclosure"] },
        "source": { "enum": ["confirmed-instance", "scanner", "hypothesis"] },
        "component_id": { "type": ["string", "null"] },
        "privilege_escalation": { "type": "boolean" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "attack_path": { "type": "string", "minLength": 1 },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "reference"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "reference": { "type": "string", "minLength": 1 }
          }
        },
        "requirement_id": { "type": ["string", "null"] },
        "requirement_url": { "type": ["string", "null"] }
      }
    }
  }
}

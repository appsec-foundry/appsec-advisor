{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/multi-repo-evidence-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_scope_sha256",
    "component_inventory_fingerprint",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "component_inventory_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id",
          "verdict",
          "reason",
          "evidence"
        ],
        "properties": {
          "local_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "verdict": {
            "enum": [
              "verified",
              "refuted",
              "ambiguous"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"
            }
          }
        }
      }
    }
  }
}

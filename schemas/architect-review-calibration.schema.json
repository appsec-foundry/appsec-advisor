{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/architect-review-calibration.schema.json",
  "title": "Architect calibration inputs and measured transport outcomes",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "live": {
      "const": false
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "comparisons": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "group_size": {
            "enum": [
              1,
              3
            ]
          },
          "manifest": {
            "$ref": "https://appsec-advisor/schemas/architect-review-context.schema.json"
          },
          "application": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "https://appsec-advisor/schemas/architect-corrections.schema.json#/$defs/batch_report"
              }
            ]
          },
          "jobs": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "packet_id": {
                  "type": "string",
                  "pattern": "^packet-[0-9]{4,}$"
                },
                "status": {
                  "enum": [
                    "prepared",
                    "completed",
                    "unavailable",
                    "unsupported_host",
                    "invalid_response",
                    "failed",
                    "deadline_exceeded",
                    "output_limit_exceeded",
                    "stage_exhausted"
                  ]
                },
                "telemetry": {
                  "type": "object",
                  "properties": {
                    "wall_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "duration_api_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "num_turns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "total_cost_usd": {
                      "type": "number",
                      "minimum": 0
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "input_tokens": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "output_tokens": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "cache_creation_input_tokens": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "cache_read_input_tokens": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [],
                      "additionalProperties": false
                    },
                    "model_ids": {
                      "type": "array",
                      "maxItems": 16,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
                      }
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "packet_id",
                "status",
                "telemetry"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "group_size",
          "manifest",
          "application",
          "jobs"
        ],
        "additionalProperties": false
      }
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rubric": {
      "$ref": "#/$defs/fixture/properties/rubric"
    }
  },
  "required": [
    "schema_version",
    "live",
    "model",
    "comparisons",
    "fixture_sha256",
    "rubric"
  ],
  "additionalProperties": false,
  "$defs": {
    "fixture": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "merged": {
          "$ref": "https://appsec-advisor/schemas/threats-merged.schema.yaml"
        },
        "analyst_context": {
          "$ref": "https://appsec-advisor/schemas/stride-analyst-context.schema.json"
        },
        "rubric": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "t_id": {
                "type": "string",
                "pattern": "^T-[0-9]{3,}$"
              },
              "assessment": {
                "enum": [
                  "unchanged",
                  "corrected"
                ]
              },
              "remediation": {
                "enum": [
                  "unchanged",
                  "corrected"
                ]
              },
              "check": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "t_id",
              "assessment",
              "remediation",
              "check"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "merged",
        "analyst_context",
        "rubric"
      ],
      "additionalProperties": false
    }
  }
}

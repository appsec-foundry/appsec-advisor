{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/multi-repo-stride.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_scope_sha256",
    "component_inventory_fingerprint",
    "component_id",
    "component_name",
    "analyzed_at",
    "partial",
    "skipped_categories",
    "coverage",
    "threats"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "component_inventory_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "component_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "component_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "analyzed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "partial": {
      "const": false
    },
    "skipped_categories": {
      "type": "array",
      "maxItems": 0
    },
    "coverage": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "disposition",
          "finding_ids",
          "reason"
        ],
        "properties": {
          "category": {
            "enum": [
              "Spoofing",
              "Tampering",
              "Repudiation",
              "Information Disclosure",
              "Denial of Service",
              "Elevation of Privilege"
            ]
          },
          "disposition": {
            "enum": [
              "finding",
              "controlled",
              "not-applicable",
              "no-evidence"
            ]
          },
          "finding_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        }
      }
    },
    "threats": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id",
          "title",
          "stride",
          "scenario",
          "likelihood",
          "impact",
          "risk",
          "evidence",
          "evidence_tier",
          "threat_category_id",
          "cwe",
          "remediation"
        ],
        "properties": {
          "stride": {
            "type": "string",
            "enum": [
              "Spoofing",
              "Tampering",
              "Repudiation",
              "Information Disclosure",
              "Denial of Service",
              "Elevation of Privilege"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 10,
            "maxLength": 80,
            "pattern": "^(?:[A-Z]|[0-9]+[A-Za-z])[^()@`]+?(?:\\s*\\([^()]+\\))?$",
            "not": {
              "anyOf": [
                {
                  "pattern": "@\\d"
                },
                {
                  "pattern": "alg:none"
                },
                {
                  "pattern": "noent:true"
                },
                {
                  "pattern": "bypassSecurityTrustHtml"
                },
                {
                  "pattern": "crypto\\.createHash"
                },
                {
                  "pattern": "\\(CVE-"
                },
                {
                  "pattern": "package-lock=false"
                },
                {
                  "pattern": "models\\.sequelize\\.query"
                }
              ]
            }
          },
          "affected_parameter": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "evidence_tier": {
            "enum": [
              "confirmed-exploitable",
              "insecure-practice"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 10
          },
          "attack_steps": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 15,
              "maxLength": 240
            }
          },
          "evidence_summary": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 20
          },
          "evidence_prose": {
            "type": [
              "string",
              "null"
            ]
          },
          "impact_description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 20
          },
          "impact_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "likelihood": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Informational"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Informational"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Informational"
            ]
          },
          "owasp_llm_ids": {
            "description": "Evidence-backed OWASP LLM Top-10 (2025) classifications, preserved from the STRIDE finding.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "LLM01",
                "LLM02",
                "LLM03",
                "LLM04",
                "LLM05",
                "LLM06",
                "LLM07",
                "LLM08",
                "LLM09",
                "LLM10"
              ]
            },
            "maxItems": 100
          },
          "owasp_asi_ids": {
            "description": "Evidence-backed OWASP Agentic Top-10 (2026) classifications, preserved from the STRIDE finding.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "ASI01",
                "ASI02",
                "ASI03",
                "ASI04",
                "ASI05",
                "ASI06",
                "ASI07",
                "ASI08",
                "ASI09",
                "ASI10"
              ]
            },
            "maxItems": 100
          },
          "base_likelihood": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.0,
            "maximum": 1.0
          },
          "actor_adjusted_likelihood": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.0,
            "maximum": 1.5
          },
          "cwe": {
            "type": "string",
            "pattern": "^CWE-\\d+$"
          },
          "evidence": {
            "$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"
          },
          "mechanism_trace": {
            "description": "Source and sink evidence retained from a confirmed STRIDE input-to-sink finding.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "sink",
              "connection",
              "control"
            ],
            "properties": {
              "input": {
                "$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"
              },
              "sink": {
                "$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"
              },
              "connection": {
                "type": "string",
                "minLength": 20,
                "maxLength": 500
              },
              "control": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "location",
                  "explanation"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "absent-at-sink",
                      "ineffective",
                      "bypassed"
                    ]
                  },
                  "location": {
                    "$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 500
                  }
                }
              }
            }
          },
          "boundary_refs": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "boundary_id",
                "origin_component_id",
                "rationale",
                "evidence_locations"
              ],
              "properties": {
                "boundary_id": {
                  "type": "string",
                  "pattern": "^tb-\\d+$"
                },
                "origin_component_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "rationale": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 240
                },
                "leg": {
                  "type": "string",
                  "enum": [
                    "validation",
                    "authentication",
                    "authorization",
                    "data-interpretation",
                    "egress-content",
                    "egress-destination",
                    "response-trust"
                  ]
                },
                "evidence_locations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "items": {
                    "$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"
                  }
                }
              }
            }
          },
          "controls_in_place": {
            "type": [
              "string",
              "null"
            ]
          },
          "violated_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "remediation_reference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional direct URL (CWE entry, OWASP cheat-sheet, internal blueprint) for the threat. Consumed by `scripts/exporters/export_sarif.py` as the SARIF `rule.helpUri`. When null, the exporter falls back to the first non-null `mitigations[m].reference` reachable via `mitigation_ids`.\n"
          },
          "architectural_theme": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Separation",
              "SecretManagement",
              "DefenseInDepth",
              "InputValidation",
              "Authorization",
              "Authentication",
              "NetworkSegmentation",
              "DataProtection",
              "AuditLogging",
              "SupplyChain",
              "SecureDefaults",
              "LeastPrivilege",
              "InsecureDesign",
              "AttackSurfaceDesign",
              "SessionDesign",
              null
            ]
          },
          "generic_threat_title": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 5,
            "maxLength": 120
          },
          "cvss_v4": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "vector",
                  "base_score",
                  "severity",
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "vector": {
                    "type": "string",
                    "pattern": "^CVSS:4\\.0(/[A-Z]+:[A-Z0-9]+)+$"
                  },
                  "base_score": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 10.0
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "None",
                      "Low",
                      "Medium",
                      "High",
                      "Critical"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "stride-analyzer",
                      "dep-scan",
                      "nvd",
                      "osv",
                      "known-vuln",
                      "manual"
                    ]
                  },
                  "version_fallback": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "3.1",
                      null
                    ]
                  }
                }
              }
            ]
          },
          "local_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "threat_category_id": {
            "type": "string",
            "pattern": "^TH-[0-9]{2}$"
          },
          "control_scope": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "remediation": {
            "type": "object",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "Low",
                  "Medium",
                  "High"
                ]
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 100,
                "minItems": 1
              },
              "code_example": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verification": {
                "type": "string",
                "minLength": 10
              },
              "reference": {
                "type": "string"
              },
              "blueprint": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "section": {
                    "type": "string"
                  }
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "effort",
              "steps",
              "verification"
            ]
          }
        }
      }
    }
  }
}
